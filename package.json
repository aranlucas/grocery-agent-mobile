{
  "name": "grocery-mobile",
  "version": "1.0.4",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo-agent-cli start",
    "start:tunnel": "EXPO_UNSTABLE_TUNNEL_V2=1 expo-agent-cli start --tunnel",
    "agent": "expo-agent-cli",
    "agent:status": "expo-agent-cli status",
    "agent:smoke:android": "expo-agent-cli smoke --android",
    "agent:skills": "expo-agent-cli skills:sync",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "pnpm build:android && pnpm build:ios",
    "build:android": "node ./scripts/native-export.mjs android",
    "build:ios": "node ./scripts/native-export.mjs ios",
    "build:simulator:ios": "pnpm dlx eas-cli build --profile ios-simulator --platform ios",
    "build:preview:android": "pnpm dlx eas-cli build --profile preview --platform android",
    "build:preview:ios": "pnpm dlx eas-cli build --profile preview --platform ios",
    "build:production:android": "pnpm dlx eas-cli build --profile production --platform android",
    "build:production:ios": "pnpm dlx eas-cli build --profile production --platform ios",
    "build:production-apk:android": "node ./scripts/android-release.mjs build",
    "publish:production-apk:android": "node ./scripts/android-release.mjs publish",
    "lint": "expo lint --max-warnings 0",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "GOMAXPROCS=2 tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "lint:fix": "expo lint --fix --max-warnings 0",
    "validate": "pnpm check && pnpm test && pnpm exec expo install --check",
    "test": "node --test scripts/*.test.mjs",
    "review:ui": "node scripts/ui-review.mjs",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@clerk/expo": "4.7.3",
    "@copilotkit/react-native": "1.76.0",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.21",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/portal": "^1.5.3",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.49.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-stream": "^0.1.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "2.1.1",
    "@expo/agent-cli": "1.0.16",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "26.6.3",
    "@types/react": "~19.2.18",
    "bufferutil": "4.1.0",
    "eslint": "^10.11.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "supports-color": "11.0.0",
    "typescript": "~6.0.3",
    "utf-8-validate": "6.0.6"
  },
  "packageManager": "pnpm@12.8.1",
  "expo": {
    "agentCli": {
      "target": "dev-build",
      "buildBackend": "local"
    }
  }
}
