{
  "name": "grocery-mobile",
  "version": "1.0.4",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo-agent-cli start",
    "start:tunnel": "EXPO_UNSTABLE_TUNNEL_V2=1 expo-agent-cli start --tunnel",
    "agent": "expo-agent-cli",
    "agent:status": "expo-agent-cli status",
    "agent:smoke:android": "expo-agent-cli smoke --android",
    "agent:skills": "expo-agent-cli skills:sync",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "portless run expo start --web",
    "build": "pnpm build:android && pnpm build:ios",
    "build:android": "node ./scripts/native-export.mjs android",
    "build:ios": "node ./scripts/native-export.mjs ios",
    "build:simulator:ios": "pnpm dlx eas-cli build --profile ios-simulator --platform ios",
    "build:feel:simulator:ios": "node ./scripts/feel-simulator.mjs build",
    "build:preview:android": "pnpm dlx eas-cli build --profile preview --platform android",
    "build:preview:ios": "pnpm dlx eas-cli build --profile preview --platform ios",
    "build:production:android": "pnpm dlx eas-cli build --profile production --platform android",
    "build:production:ios": "pnpm dlx eas-cli build --profile production --platform ios",
    "build:production-apk:android": "node ./scripts/android-release.mjs build",
    "publish:production-apk:android": "node ./scripts/android-release.mjs publish",
    "lint": "expo lint --max-warnings 0 && pnpm lint:tailwind",
    "fmt": "pnpm styles:prepare && oxfmt --threads=2 --write .",
    "fmt:check": "pnpm styles:prepare && oxfmt --threads=2 --check .",
    "typecheck": "GOMAXPROCS=2 tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "lint:fix": "expo lint --fix --max-warnings 0 && pnpm lint:tailwind --fix",
    "validate": "pnpm check && pnpm test && pnpm exec expo install --check",
    "test": "vitest run",
    "review:ui": "node scripts/ui-review.mjs",
    "postinstall": "pnpm styles:prepare",
    "prepare": "husky",
    "styles:prepare": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
    "lint:tailwind": "oxlint --config .oxlintrc.json src scripts --deny-warnings"
  },
  "dependencies": {
    "@clerk/expo": "4.14.0",
    "@copilotkit/react-native": "1.79.1",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.22",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/portal": "^1.5.3",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-auth-session": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-stream": "^0.1.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "1.12.2"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@babel/core": "^7.29.7",
    "@eslint/compat": "2.1.1",
    "@expo/agent-cli": "1.0.20",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@types/node": "26.6.5",
    "@types/react": "~19.3.0",
    "bufferutil": "4.1.0",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tailwindcss": "1.16.0",
    "portless": "0.15.8",
    "react-test-renderer": "19.3.0",
    "supports-color": "11.0.0",
    "typescript": "~6.0.3",
    "utf-8-validate": "6.0.6",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --config .oxlintrc.json --deny-warnings --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0",
  "expo": {
    "agent-cli": {
      "target": "dev-build",
      "buildBackend": "local"
    }
  }
}
