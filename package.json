{
  "name": "grocery-mobile",
  "version": "1.0.4",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "pnpm build:android && pnpm build:ios",
    "build:android": "node ./scripts/native-export.mjs android",
    "build:ios": "node ./scripts/native-export.mjs ios",
    "build:simulator:ios": "pnpm dlx eas-cli build --profile ios-simulator --platform ios",
    "build:preview:android": "pnpm dlx eas-cli build --profile preview --platform android",
    "build:preview:ios": "pnpm dlx eas-cli build --profile preview --platform ios",
    "build:production:android": "pnpm dlx eas-cli build --profile production --platform android",
    "build:production:ios": "pnpm dlx eas-cli build --profile production --platform ios",
    "build:production-apk:android": "node ./scripts/android-release.mjs build",
    "publish:production-apk:android": "node ./scripts/android-release.mjs publish",
    "lint": "oxlint --config .oxlintrc.json --threads=2 --deny-warnings src scripts plugins packages index.js app.config.js metro.config.js",
    "fmt": "oxfmt --config .oxfmtrc.json --threads=2 .",
    "fmt:check": "oxfmt --config .oxfmtrc.json --threads=2 --check .",
    "typecheck": "GOMAXPROCS=2 tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "lint:fix": "oxlint --config .oxlintrc.json --threads=2 --deny-warnings --fix src scripts plugins packages index.js app.config.js metro.config.js",
    "validate": "pnpm check && pnpm exec expo install --check"
  },
  "dependencies": {
    "@agents/types": "workspace:*",
    "@clerk/expo": "^4.6.8",
    "@copilotkit/react-native": "1.72.0",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.18",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/hover-card": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.17",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.46.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-stream": "^0.1.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@types/node": "26.6.0",
    "@types/react": "~19.2.18",
    "bufferutil": "4.1.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tailwindcss": "1.12.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pnpm-sync-dependencies-meta-injected": "^0.0.15",
    "supports-color": "11.0.0",
    "typescript": "^6.0.3",
    "utf-8-validate": "6.0.6"
  },
  "packageManager": "pnpm@12.4.2"
}
