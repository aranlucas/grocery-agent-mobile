{
  "name": "grocery-mobile",
  "version": "1.0.4",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo-agent-cli start",
    "start:tunnel": "EXPO_UNSTABLE_TUNNEL_V2=1 expo-agent-cli start --tunnel",
    "agent": "expo-agent-cli",
    "agent:status": "expo-agent-cli status",
    "agent:smoke:android": "expo-agent-cli smoke --android",
    "agent:skills": "expo-agent-cli skills:sync",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "pnpm build:android && pnpm build:ios",
    "build:android": "node ./scripts/native-export.mjs android",
    "build:ios": "node ./scripts/native-export.mjs ios",
    "build:simulator:ios": "pnpm dlx eas-cli build --profile ios-simulator --platform ios",
    "build:preview:android": "pnpm dlx eas-cli build --profile preview --platform android",
    "build:preview:ios": "pnpm dlx eas-cli build --profile preview --platform ios",
    "build:production:android": "pnpm dlx eas-cli build --profile production --platform android",
    "build:production:ios": "pnpm dlx eas-cli build --profile production --platform ios",
    "build:production-apk:android": "node ./scripts/android-release.mjs build",
    "publish:production-apk:android": "node ./scripts/android-release.mjs publish",
    "lint": "expo lint --max-warnings 0",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "GOMAXPROCS=2 tsc --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "lint:fix": "expo lint --fix --max-warnings 0",
    "validate": "pnpm check && pnpm test && pnpm exec expo install --check",
    "test": "node --test scripts/*.test.mjs",
    "review:ui": "node scripts/ui-review.mjs",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "dependencies": {
    "@clerk/expo": "4.6.8",
    "@copilotkit/react-native": "1.73.3",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~58.0.7",
    "@expo/ui": "~58.0.7",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/portal": "^1.5.3",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "expo": "~58.0.0-preview.7",
    "expo-asset": "~58.0.7",
    "expo-auth-session": "~58.0.5",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~58.0.2",
    "expo-dev-client": "~58.0.7",
    "expo-font": "~58.0.2",
    "expo-image": "~58.0.6",
    "expo-linking": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-system-ui": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "lucide-react-native": "^1.46.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-markdown-stream": "^0.1.4",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/agent-cli": "1.0.13",
    "@react-native/babel-preset": "0.88.0-rc.0",
    "@react-native/metro-config": "0.88.0-rc.1",
    "@types/node": "26.6.0",
    "@types/react": "~19.3.0",
    "bufferutil": "4.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "supports-color": "11.0.0",
    "typescript": "^6.0.3",
    "utf-8-validate": "6.0.6"
  },
  "packageManager": "pnpm@12.4.2",
  "expo": {
    "agentCli": {
      "target": "dev-build",
      "buildBackend": "local"
    }
  }
}
