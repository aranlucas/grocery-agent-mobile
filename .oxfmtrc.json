{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSameLine": false,
  "singleAttributePerLine": false,
  "ignorePatterns": [
    "AGENTS.md",
    ".agents/**",
    "src/lib/grocery-gateway.d.ts",
    "src/uniwind-types.d.ts",
    "pnpm-lock.yaml"
  ]
}
